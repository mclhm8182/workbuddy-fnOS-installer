appname = fnwb.workbuddy
version = 1.2.7
display_name = WorkBuddy
desc = WorkBuddy 的第三方安装器。安装时从官方地址获取官方 .deb 并解包为 fnOS 应用，不包含 WorkBuddy 任何二进制。本工具与 WorkBuddy 官方无隶属关系。
platform = x86
source = thirdparty
maintainer = workbuddy-fnOS-installer Contributors
maintainer_url = https://github.com/mclhm8182/workbuddy-fnOS-installer
distributor = workbuddy-fnOS-installer Contributors
distributor_url = https://github.com/mclhm8182/workbuddy-fnOS-installer
service_port = 8090
checkport = false
os_min_version = 1.1.3100
desktop_uidir = ui
desktop_applaunchname = fnwb.workbuddy.main
install_type = root
ctl_stop = true
changelog = 支持安装时指定工作区与端口：安装前在 /vol1/1000/app_workbuddy.install.conf 里写 WORKSPACE=/path 与 PORT=8092（也支持环境变量 WORKBUDDY_WORKSPACE/WORKBUDDY_PORT），安装时即生效；解析结果落入 $APP_DATA/instance.conf，该文件重装与升级都不覆盖，所以安装时定的工作区/端口会被后续官方更新继承。端口改为自动检测：未指定时 8090 空闲则用 8090，被其它进程占用则自动向后挑选空闲端口并提示，被本应用占用（升级场景）则沿用；显式指定的端口若被占用会明确报错并给出改法，而不是静默改动。manifest 的 checkport 关闭，避免 8090 被占用导致整个安装被应用中心拦下。安装结尾与桌面入口都按最终端口生成。同时修复：缺 ar（binutils）时改用 dpkg-deb 解完整包补齐 web-ui，不再静默退化为占位页；生成的 start.sh 固定工作区，避免把 / 当 workspace 递归扫描整盘导致网页无响应。
